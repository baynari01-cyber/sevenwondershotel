// Seven Wonders Hotel Petra — demo booking platform by BAYNARI
// All rates, inventory and reservations seeded from this schema are fictional demo data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  FRONT_DESK
  VIEWER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAY_AT_PROPERTY
  SIMULATED_PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  PAY_AT_PROPERTY
  SIMULATED_CARD
  BANK_TRANSFER
  CASH
}

enum BookingSource {
  WEBSITE
  WALK_IN
  PHONE
  EMAIL
  OTA
  TRAVEL_AGENT
  ADMIN
}

enum RatePlanType {
  ROOM_ONLY
  BED_AND_BREAKFAST
  FLEXIBLE
  NON_REFUNDABLE
  PROMOTIONAL
}

enum AdjustmentType {
  PERCENT
  FIXED
}

enum ExtraPricing {
  PER_STAY
  PER_NIGHT
  PER_PERSON
  PER_PERSON_PER_NIGHT
}

enum BlockReason {
  MAINTENANCE
  OUT_OF_ORDER
  OWNER_USE
  OTHER
}

enum GalleryCategory {
  ROOMS
  DINING
  POOL
  WELLNESS
  HOTEL
  PETRA
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(VIEWER)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  notes        ReservationNote[]
  activities   ActivityLog[]
  blocks       InventoryBlock[]
  reservations Reservation[] @relation("CreatedBy")
}

model HotelSettings {
  id                 String   @id @default("default")
  nameEn             String
  nameAr             String
  taglineEn          String
  taglineAr          String
  addressEn          String
  addressAr          String
  city               String
  country            String
  postalBox          String?
  phone              String
  phoneSecondary     String?
  fax                String?
  email              String
  whatsapp           String?
  latitude           Decimal  @db.Decimal(9, 6)
  longitude          Decimal  @db.Decimal(9, 6)
  checkInTime        String
  checkOutTime       String
  currency           String   @default("JOD")
  displayCurrencies  String[] @default(["JOD", "USD", "EUR"])
  usdRate            Decimal  @db.Decimal(10, 4) @default(1.41)
  eurRate            Decimal  @db.Decimal(10, 4) @default(1.30)
  taxRate            Decimal  @db.Decimal(5, 2) @default(16)
  serviceChargeRate  Decimal  @db.Decimal(5, 2) @default(10)
  taxesIncluded      Boolean  @default(false)
  childAgeLimit      Int      @default(12)
  weekendDays        Int[]    @default([5, 6])
  maxRoomsPerBooking Int      @default(5)
  maxNightsPerBooking Int     @default(30)
  demoMode           Boolean  @default(true)
  facebookUrl        String?
  instagramUrl       String?
  tripadvisorUrl     String?
  updatedAt          DateTime @updatedAt
}

model HotelPolicy {
  id        String  @id @default(cuid())
  key       String  @unique
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
  isVerified Boolean @default(false)
}

model Amenity {
  id        String            @id @default(cuid())
  key       String            @unique
  labelEn   String
  labelAr   String
  icon      String
  category  String            @default("room")
  sortOrder Int               @default(0)
  roomTypes RoomTypeAmenity[]
}

model RoomType {
  id              String            @id @default(cuid())
  slug            String            @unique
  code            String            @unique
  nameEn          String
  nameAr          String
  shortEn         String
  shortAr         String
  descriptionEn   String
  descriptionAr   String
  bedConfigEn     String
  bedConfigAr     String
  sizeSqm         Int?
  maxAdults       Int
  maxChildren     Int               @default(0)
  maxOccupancy    Int
  baseRate        Decimal           @db.Decimal(10, 2)
  weekendRate     Decimal?          @db.Decimal(10, 2)
  extraAdultRate  Decimal           @db.Decimal(10, 2) @default(0)
  extraChildRate  Decimal           @db.Decimal(10, 2) @default(0)
  minStay         Int               @default(1)
  hasBalcony      Boolean           @default(false)
  isSuite         Boolean           @default(false)
  isActive        Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  sortOrder       Int               @default(0)
  amenities       RoomTypeAmenity[]
  images          RoomImage[]
  rooms           Room[]
  seasonRates     SeasonRate[]
  overrides       RateOverride[]
  reservationRooms ReservationRoom[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model RoomTypeAmenity {
  roomTypeId String
  amenityId  String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  altEn      String
  altAr      String
  sortOrder  Int      @default(0)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
}

model Room {
  id               String            @id @default(cuid())
  roomTypeId       String
  number           String            @unique
  floor            Int
  hasBalcony       Boolean           @default(false)
  isActive         Boolean           @default(true)
  notes            String?
  roomType         RoomType          @relation(fields: [roomTypeId], references: [id])
  blocks           InventoryBlock[]
  reservationRooms ReservationRoom[]

  @@index([roomTypeId])
}

model RatePlan {
  id                       String            @id @default(cuid())
  code                     String            @unique
  nameEn                   String
  nameAr                   String
  descriptionEn            String
  descriptionAr            String
  type                     RatePlanType
  adjustmentType           AdjustmentType    @default(PERCENT)
  adjustmentValue          Decimal           @db.Decimal(10, 2) @default(0)
  includesBreakfast        Boolean           @default(false)
  refundable               Boolean           @default(true)
  cancellationDeadlineDays Int               @default(2)
  cancellationPolicyEn     String
  cancellationPolicyAr     String
  minNights                Int               @default(1)
  validFrom                DateTime?         @db.Date
  validTo                  DateTime?         @db.Date
  isActive                 Boolean           @default(true)
  isDemo                   Boolean           @default(true)
  sortOrder                Int               @default(0)
  reservationRooms         ReservationRoom[]
}

model Season {
  id        String       @id @default(cuid())
  nameEn    String
  nameAr    String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  isActive  Boolean      @default(true)
  rates     SeasonRate[]
}

model SeasonRate {
  seasonId   String
  roomTypeId String
  rate       Decimal  @db.Decimal(10, 2)
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([seasonId, roomTypeId])
}

model RateOverride {
  id           String   @id @default(cuid())
  roomTypeId   String
  date         DateTime @db.Date
  rate         Decimal? @db.Decimal(10, 2)
  minStay      Int?
  closed       Boolean  @default(false)
  maxInventory Int?
  note         String?
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
}

model Promotion {
  id        String         @id @default(cuid())
  code      String         @unique
  nameEn    String
  nameAr    String
  type      AdjustmentType
  value     Decimal        @db.Decimal(10, 2)
  minNights Int            @default(1)
  validFrom DateTime       @db.Date
  validTo   DateTime       @db.Date
  isActive  Boolean        @default(true)
  reservations Reservation[]
}

model Extra {
  id            String             @id @default(cuid())
  code          String             @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  price         Decimal            @db.Decimal(10, 2)
  pricing       ExtraPricing       @default(PER_STAY)
  isInquiryOnly Boolean            @default(false)
  isActive      Boolean            @default(true)
  isDemo        Boolean            @default(true)
  sortOrder     Int                @default(0)
  icon          String             @default("sparkles")
  reservationExtras ReservationExtra[]
}

model InventoryBlock {
  id          String      @id @default(cuid())
  roomId      String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      BlockReason @default(MAINTENANCE)
  note        String?
  createdById String?
  createdAt   DateTime    @default(now())
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id])

  @@index([roomId, startDate, endDate])
}

model Guest {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  country      String
  notes        String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]

  @@index([email])
}

model Reservation {
  id                   String             @id @default(cuid())
  reference            String             @unique
  status               ReservationStatus  @default(CONFIRMED)
  source               BookingSource      @default(WEBSITE)
  guestId              String
  checkIn              DateTime           @db.Date
  checkOut             DateTime           @db.Date
  nights               Int
  adults               Int
  children             Int                @default(0)
  currency             String             @default("JOD")
  roomSubtotal         Decimal            @db.Decimal(12, 2)
  extrasTotal          Decimal            @db.Decimal(12, 2) @default(0)
  discountTotal        Decimal            @db.Decimal(12, 2) @default(0)
  taxTotal             Decimal            @db.Decimal(12, 2) @default(0)
  serviceChargeTotal   Decimal            @db.Decimal(12, 2) @default(0)
  grandTotal           Decimal            @db.Decimal(12, 2)
  paymentStatus        PaymentStatus      @default(PAY_AT_PROPERTY)
  paymentMethod        PaymentMethod      @default(PAY_AT_PROPERTY)
  specialRequests      String?
  arrivalTime          String?
  locale               String             @default("en")
  promotionId          String?
  promotionCode        String?
  cancellationPolicyEn String
  cancellationPolicyAr String
  cancelledAt          DateTime?
  cancellationReason   String?
  createdById          String?
  isDemo               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  guest                Guest              @relation(fields: [guestId], references: [id])
  promotion            Promotion?         @relation(fields: [promotionId], references: [id])
  createdBy            User?              @relation("CreatedBy", fields: [createdById], references: [id])
  rooms                ReservationRoom[]
  extras               ReservationExtra[]
  payments             Payment[]
  notes                ReservationNote[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([createdAt])
}

model ReservationRoom {
  id            String      @id @default(cuid())
  reservationId String
  roomTypeId    String
  roomId        String?
  ratePlanId    String
  adults        Int
  children      Int         @default(0)
  nightlyRates  Json
  roomTotal     Decimal     @db.Decimal(12, 2)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType      RoomType    @relation(fields: [roomTypeId], references: [id])
  room          Room?       @relation(fields: [roomId], references: [id])
  ratePlan      RatePlan    @relation(fields: [ratePlanId], references: [id])

  @@index([roomId])
  @@index([roomTypeId])
}

model ReservationExtra {
  id            String       @id @default(cuid())
  reservationId String
  extraId       String
  nameEn        String
  nameAr        String
  quantity      Int          @default(1)
  unitPrice     Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(12, 2)
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  extra         Extra        @relation(fields: [extraId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus
  reference     String?
  note          String?
  createdAt     DateTime      @default(now())
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model ReservationNote {
  id            String      @id @default(cuid())
  reservationId String
  authorId      String?
  body          String
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  author        User?       @relation(fields: [authorId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

model ContentBlock {
  id         String   @id @default(cuid())
  key        String   @unique
  page       String
  section    String
  titleEn    String
  titleAr    String
  subtitleEn String?
  subtitleAr String?
  bodyEn     String
  bodyAr     String
  imageUrl   String?
  linkHref   String?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@index([page])
}

model GalleryImage {
  id        String          @id @default(cuid())
  url       String
  captionEn String
  captionAr String
  category  GalleryCategory
  width     Int
  height    Int
  source    String
  sortOrder Int             @default(0)
  isVisible Boolean         @default(true)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  locale    String   @default("en")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
