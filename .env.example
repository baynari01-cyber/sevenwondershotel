# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# 32+ random characters. Used to sign admin session cookies. Never commit the real value.
SESSION_SECRET="generate-with: openssl rand -hex 32"

# Credentials created by `pnpm db:seed` for the demo administrator account.
DEMO_ADMIN_EMAIL="admin@demo.baynari.local"
DEMO_ADMIN_PASSWORD="choose-a-strong-demo-password"

# Public origin of the deployment, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL="https://your-deployment.vercel.app"
